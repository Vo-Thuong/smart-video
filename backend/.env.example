# MongoDB
MONGODB_URI=mongodb://localhost:27017/smart-video

# JWT
JWT_SECRET=your_jwt_secret_key_here

# Google OAuth
GOOGLE_CLIENT_ID=your_google_client_id_here

# Gmail SMTP (dùng Gmail App Password)
EMAIL_USER=your_gmail@gmail.com
EMAIL_PASSWORD=your_gmail_app_password

# Frontend URL (dùng trong email)
FRONTEND_URL=http://localhost:3000

# Gemini AI (dùng để transcribe video tải lên)
# Lấy key miễn phí tại: https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Deepgram (fallback transcription — free $200 credit, không cần thẻ tín dụng)
# Đăng ký tại: https://console.deepgram.com/signup
DEEPGRAM_API_KEY=your_deepgram_api_key_here
